# Ejemplo de variables de entorno
# Copia este archivo como .env.local y completa con tus valores reales

# Google Analytics 4
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX



# Dominio del sitio (para sitemap y canonical URLs)
PUBLIC_SITE_URL=https://cynkids.com

# Meta Pixel de Facebook (opcional)
PUBLIC_FB_PIXEL_ID=

# Modo de desarrollo
PUBLIC_DEV_MODE=false

# Stripe (lectoescritura.cynponceglz.com)
# NUNCA subir al repo — agregar en Vercel Dashboard > Settings > Environment Variables
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Facebook Conversions API — server-side (lectoescritura.cynponceglz.com)
# Obtener en: Meta Business > Events Manager > tu Pixel > Settings > Conversions API > Generate access token
# NUNCA subir al repo — agregar en Vercel Dashboard > Settings > Environment Variables
FB_PIXEL_ID=1024976901790952
FB_ACCESS_TOKEN=
# FB_TEST_EVENT_CODE=TEST12345   # Solo para pruebas en Events Manager — comentar en producción
