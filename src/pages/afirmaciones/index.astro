---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';

const STRIPE_LINK = "https://buy.stripe.com/aFacN5gx42HWcU1bb92wU04";

const seo = {
  title: '30 Tarjetas de Afirmaciones Positivas | Cyn',
  description: 'Un recurso digital imprimible para acompañar la autoestima, la confianza y el lenguaje emocional de tu peque con una afirmación diaria.',
  image: '/images/afirmaciones-mockup.png',
  noindex: false,
};

const kitItems = [
  { name: 'Afirmaciones de autoestima y amor propio', detail: '5 tarjetas', text: 'Palabras que ayudan a tu peque a reconocerse valioso, amado y suficiente tal como es.' },
  { name: 'Afirmaciones de confianza y seguridad', detail: '5 tarjetas', text: 'Frases para acompañar momentos de duda y reforzar la capacidad de intentar cosas nuevas.' },
  { name: 'Afirmaciones de valentía y coraje', detail: '4 tarjetas', text: 'Palabras que normalizan el miedo y celebran el esfuerzo de seguir adelante.' },
  { name: 'Afirmaciones de inteligencia emocional', detail: '4 tarjetas', text: 'Frases para nombrar emociones, validarlas y acompañarlas con presencia.' },
  { name: 'Afirmaciones de gratitud y alegría', detail: '4 tarjetas', text: 'Momentos para notar lo bueno del día y cultivar una mirada agradecida.' },
  { name: 'Afirmaciones de resiliencia y crecimiento', detail: '4 tarjetas', text: 'Palabras para los días difíciles: que los errores enseñan y que siempre hay un siguiente paso.' },
  { name: 'Afirmaciones de creatividad, aprendizaje y conexión', detail: '4 tarjetas', text: 'Frases que celebran la curiosidad, el aprendizaje y el vínculo con quienes nos rodean.' },
];

const benefits = [
  'Crear una rutina emocional sencilla con un solo momento al día.',
  'Abrir conversaciones naturales sobre emociones y sentimientos.',
  'Fortalecer autoestima y amor propio con palabras repetidas con amor.',
  'Acompañar momentos de frustración o inseguridad con calma.',
  'Darle a tu peque palabras que pueda recordar en días difíciles.',
  'Crear un ritual de conexión breve pero significativo.',
];

const fit = [
  'Quieres crear una rutina emocional sencilla con tu peque.',
  'Te interesa la crianza consciente y el lenguaje emocional.',
  'Buscas recursos imprimibles fáciles de usar en casa o el aula.',
  'Eres mamá, papá, cuidadora o educadora.',
  'Quieres una actividad breve, bonita y significativa cada día.',
];

const notFit = [
  'Buscas una solución terapéutica o clínica para tu peque.',
  'Quieres corregir conducta solo con frases o afirmaciones.',
  'No estás dispuesto a acompañar con presencia y conversación.',
  'Buscas un recurso físico enviado a domicilio. Este producto es digital.',
];

const steps = [
  'Imprime las tarjetas.',
  'Recorta y colócalas en un lugar accesible.',
  'Cada día elijan una tarjeta.',
  'Lean juntos la afirmación.',
  'Conversen brevemente sobre lo que significa.',
  'Déjenla visible durante el día o úsala antes de dormir.',
];
---

<BaseLayout seo={seo}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet">
    <style>
      :root {
        --cream: #fff8ee;
        --cream-2: #f7eadb;
        --paper: #fffdf8;
        --ink: #392a24;
        --muted: #79665b;
        --rose: #d87982;
        --rose-deep: #bf5d69;
        --peach: #f0c7a3;
        --line: #ead9ca;
        --leaf: #6f7d55;
      }
      .afirm-page { font-family: 'Manrope', system-ui, sans-serif; background: var(--cream); color: var(--ink); }
      .display { font-family: 'Libre Baskerville', Georgia, serif; }
      .soft-shadow { box-shadow: 0 30px 80px rgba(87, 55, 41, 0.16); }
      .premium-ring { box-shadow: inset 0 0 0 1px rgba(191, 93, 105, 0.18), 0 20px 50px rgba(191, 93, 105, 0.12); }
    </style>
  </Fragment>

  <main class="afirm-page overflow-hidden">
    <!-- Hero -->
    <section class="relative px-5 pt-10 pb-20 md:pt-16 md:pb-28">
      <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div class="absolute -top-28 -right-20 h-80 w-80 rounded-full bg-[#f3c7c7]/50 blur-3xl"></div>
        <div class="absolute top-72 -left-28 h-96 w-96 rounded-full bg-[#f0c7a3]/45 blur-3xl"></div>
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#d87982]/30 to-transparent"></div>
      </div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-8 lg:gap-12 lg:grid-cols-[0.92fr_1.08fr]">
        <div class="order-2 lg:order-1">
          <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-[#eac8c7] bg-[#fffdf8]/80 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-[#bf5d69]">
            <span class="h-2 w-2 rounded-full bg-[#d87982]"></span>
            Descargable e imprimible
          </div>

          <h1 class="display max-w-3xl text-[2.6rem] font-bold leading-[1.08] tracking-[-0.04em] text-[#35261f] md:text-[4rem] lg:text-[4.5rem]">
            30 Tarjetas de <span class="text-[#c96572]">Afirmaciones Positivas</span> para crear un ritual amoroso con tu peque
          </h1>

          <p class="mt-7 max-w-xl text-lg leading-8 text-[#6f5b50] md:text-xl">
            Un recurso digital imprimible para acompañar la autoestima, la confianza y el lenguaje emocional de tu peque con una afirmación diaria.
          </p>

          <div class="mt-9 rounded-[1.6rem] border border-[#ead9ca] bg-[#fffdf8]/82 p-5 premium-ring backdrop-blur sm:max-w-xl">
            <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="text-sm font-bold uppercase tracking-[0.16em] text-[#bf5d69]">Pago único</p>
                <p class="mt-1 text-4xl font-extrabold tracking-[-0.04em] text-[#35261f]">$97 <span class="text-base font-semibold text-[#79665b]">MXN</span></p>
              </div>
              <a
                href={STRIPE_LINK}
                class="inline-flex items-center justify-center rounded-full bg-[#bf5d69] px-7 py-4 text-base font-extrabold text-[#fffdf8] transition duration-200 hover:-translate-y-0.5 hover:bg-[#a94c59] focus:outline-none focus:ring-4 focus:ring-[#d87982]/30"
              >
                Quiero mis tarjetas
              </a>
            </div>
            <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-[#79665b]">
              <span>30 tarjetas incluidas</span>
              <span>Descarga inmediata</span>
              <span>Pago seguro con Stripe</span>
            </div>
          </div>
        </div>

        <div class="order-1 lg:order-2">
          <div class="relative mx-auto max-w-[610px]">
            <div class="absolute -inset-4 rotate-2 rounded-[2rem] bg-[#d87982]/18 blur-2xl"></div>
            <img
              src="/images/afirmaciones-mockup.png"
              alt="Mockup de las 30 Tarjetas de Afirmaciones Positivas imprimibles"
              class="relative w-full rounded-[1.8rem] border border-[#fffdf8] bg-[#fffdf8] object-cover soft-shadow"
              width="1086"
              height="1086"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Problema -->
    <section class="bg-[#fffdf8] px-5 py-20 md:py-28">
      <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-[0.9fr_1.1fr] md:items-start">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-[#bf5d69]">El contexto real</p>
          <h2 class="display mt-4 text-3xl font-bold leading-tight tracking-[-0.03em] text-[#35261f] md:text-5xl">
            Los niños también necesitan palabras para ordenar su mundo interior.
          </h2>
        </div>
        <div class="space-y-6 text-lg leading-8 text-[#6f5b50]">
          <p>
            Los niños no solo necesitan rutinas para ordenar su día. También necesitan palabras que les ayuden a ordenar su mundo interior.
          </p>
          <p>
            Muchas veces les pedimos calma, seguridad o confianza, pero no siempre les damos herramientas simples para practicarlo en casa.
          </p>
          <p class="rounded-[1.4rem] bg-[#fff3f1] p-5 font-bold text-[#9f4d56]">
            Una afirmación diaria puede convertirse en un momento de conexión: una frase, una mirada, una conversación.
          </p>
        </div>
      </div>
    </section>

    <!-- Qué es -->
    <section class="px-5 py-20 md:py-28">
      <div class="mx-auto max-w-6xl">
        <div class="mb-14 max-w-2xl">
          <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-[#bf5d69]">Qué incluye</p>
          <h2 class="display mt-4 text-3xl font-bold leading-tight tracking-[-0.03em] text-[#35261f] md:text-5xl">
            30 tarjetas. Una para cada día del mes.
          </h2>
          <p class="mt-5 text-lg leading-8 text-[#6f5b50]">
            Cada tarjeta incluye una afirmación breve para abrir conversación y fortalecer el lenguaje emocional.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {kitItems.map((item, index) => (
            <article class={`group rounded-[1.6rem] border border-[#ead9ca] bg-[#fffdf8] p-5 transition duration-200 hover:-translate-y-1 hover:border-[#d87982]/45 hover:shadow-xl hover:shadow-[#bf5d69]/10${index === kitItems.length - 1 ? ' sm:col-span-2 lg:col-span-2' : ''}`}>
              <div class="mb-8 flex items-center justify-between">
                <span class="display text-4xl font-bold text-[#e4b0b5]">{String(index + 1).padStart(2, '0')}</span>
                <span class="h-3 w-3 rounded-full bg-[#d87982]/55 transition group-hover:bg-[#bf5d69]"></span>
              </div>
              <h3 class="text-base font-extrabold leading-tight text-[#35261f]">{item.name}</h3>
              <p class="mt-2 text-xs font-extrabold uppercase tracking-[0.13em] text-[#bf5d69]">{item.detail}</p>
              <p class="mt-5 text-sm leading-6 text-[#79665b]">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Ritual amoroso -->
    <section class="bg-[#35261f] px-5 py-20 text-[#fff8ee] md:py-28">
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1fr_0.9fr] lg:items-center">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-[#f0b3b8]">Ritual amoroso de afirmaciones</p>
          <h2 class="display mt-4 text-3xl font-bold leading-tight tracking-[-0.03em] md:text-5xl">
            Un ritual amoroso no necesita ser complicado.
          </h2>
          <p class="mt-6 text-lg leading-8 text-[#ead9ca]">
            Puede ser una tarjeta, una frase y unos minutos de presencia real. Cuando una afirmación se repite dentro de una rutina amorosa, deja de ser solo una frase: se convierte en una experiencia de seguridad, vínculo y lenguaje emocional.
          </p>
          <p class="mt-4 text-base font-bold text-[#f0b3b8]">
            Una tarjeta al día. Una afirmación. Un momento de conexión.
          </p>
        </div>
        <div class="grid gap-4">
          {steps.map((step, i) => (
            <div class="flex gap-5 rounded-[1.4rem] border border-[#fff8ee]/12 bg-[#fff8ee]/6 p-5">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#d87982] text-sm font-extrabold text-[#35261f]">{i + 1}</div>
              <div class="flex items-center">
                <p class="text-sm leading-6 text-[#ead9ca] font-semibold">{step}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Beneficios -->
    <section class="bg-[#fffdf8] px-5 py-20 md:py-28">
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
        <div class="relative mx-auto max-w-md lg:max-w-none lg:mx-0">
          <img
            src="/images/afirmaciones-mockup.png"
            alt="Vista del producto Tarjetas de Afirmaciones Positivas"
            class="w-full rounded-[1.6rem] border border-[#ead9ca] soft-shadow"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-[#bf5d69]">Para qué puede ayudarte</p>
          <h2 class="display mt-4 text-3xl font-bold leading-tight tracking-[-0.03em] text-[#35261f] md:text-5xl">
            Una herramienta sencilla para acompañar la vida emocional de tu peque.
          </h2>
          <div class="mt-9 grid gap-4 sm:grid-cols-2">
            {benefits.map((benefit) => (
              <div class="rounded-[1.3rem] border border-[#ead9ca] bg-[#fff8ee] p-5">
                <svg class="mb-4 h-5 w-5 text-[#bf5d69]" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M4 10.5l3.4 3.4L16 5.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <p class="text-sm font-semibold leading-6 text-[#5f4c42]">{benefit}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Para quién es -->
    <section class="px-5 py-20 md:py-28">
      <div class="mx-auto max-w-6xl">
        <h2 class="display max-w-2xl text-3xl font-bold leading-tight tracking-[-0.03em] text-[#35261f] md:text-5xl">
          Para quién tiene sentido este recurso
        </h2>
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          <div class="rounded-[1.6rem] border border-[#ead9ca] bg-[#fffdf8] p-6 md:p-8">
            <p class="mb-7 text-xs font-extrabold uppercase tracking-[0.18em] text-[#bf5d69]">Sí es para ti si</p>
            <ul class="space-y-5">
              {fit.map((item) => (
                <li class="flex gap-3 text-sm font-semibold leading-6 text-[#5f4c42]">
                  <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-[#d87982]"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="rounded-[1.6rem] border border-[#ead9ca] bg-[#f7eadb]/55 p-6 md:p-8">
            <p class="mb-7 text-xs font-extrabold uppercase tracking-[0.18em] text-[#79665b]">No es para ti si</p>
            <ul class="space-y-5">
              {notFit.map((item) => (
                <li class="flex gap-3 text-sm font-semibold leading-6 text-[#79665b]">
                  <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full border border-[#79665b]/45"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA final -->
    <section class="relative px-5 pb-28 pt-12 md:pb-32">
      <div class="mx-auto max-w-4xl rounded-[2rem] bg-[#35261f] p-7 text-center text-[#fff8ee] soft-shadow md:p-12">
        <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-[#f0b3b8]">Descarga inmediata</p>
        <h2 class="display mx-auto mt-4 max-w-2xl text-3xl font-bold leading-tight tracking-[-0.03em] md:text-5xl">
          Empieza hoy un ritual amoroso con tu peque.
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-7 text-[#ead9ca]">
          Descarga tus tarjetas, imprímelas y usa una afirmación diaria para crear momentos de conexión, autoestima y seguridad emocional.
        </p>

        <div class="mx-auto mt-9 max-w-md rounded-[1.4rem] border border-[#fff8ee]/12 bg-[#fff8ee]/7 p-5">
          <p class="text-5xl font-extrabold tracking-[-0.05em]">$97 <span class="text-lg font-semibold text-[#ead9ca]">MXN</span></p>
          <p class="mt-2 text-sm font-semibold text-[#ead9ca]">Pago único · Acceso permanente · Pago seguro</p>
          <a
            href={STRIPE_LINK}
            class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-[#d87982] px-7 py-4 text-base font-extrabold text-[#35261f] transition duration-200 hover:-translate-y-0.5 hover:bg-[#f0b3b8] focus:outline-none focus:ring-4 focus:ring-[#d87982]/30"
          >
            Comprar ahora
          </a>
        </div>

        <p class="mx-auto mt-6 max-w-xl text-xs leading-5 text-[#cdbbac]">
          Este producto es una herramienta de acompañamiento emocional y conexión familiar. No sustituye atención psicológica, diagnóstico ni tratamiento profesional cuando se necesite.
        </p>
      </div>
    </section>

    <!-- Mobile sticky CTA -->
    <div class="fixed bottom-0 left-0 right-0 z-50 border-t border-[#ead9ca] bg-[#fffdf8]/95 px-4 py-3 backdrop-blur md:hidden">
      <a
        href={STRIPE_LINK}
        class="block rounded-full bg-[#bf5d69] px-6 py-3 text-center text-sm font-extrabold text-[#fffdf8] transition-colors duration-200 hover:bg-[#a94c59]"
      >
        Quiero mis tarjetas · $97 MXN
      </a>
    </div>
  </main>

  <!-- ══════════════════════════════════════════════
       TRACKING — Facebook Pixel + GTM
       ViewContent on load · InitiateCheckout on click
       Producto: tarjetas-afirmaciones — NO mezclar con kit-lectoescritura
  ══════════════════════════════════════════════ -->
  <script is:inline>
  (function () {
    var PRODUCT = {
      content_name: '30 Tarjetas de Afirmaciones Positivas',
      content_category: 'Producto Digital',
      content_ids: ['tarjetas-afirmaciones'],
      content_type: 'product',
      value: 97,
      currency: 'MXN',
    };

    // 1. ViewContent
    if (window.fbq) {
      window.fbq('track', 'ViewContent', PRODUCT);
    }

    // GTM / GA4 view_item
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ ecommerce: null });
    window.dataLayer.push({
      event: 'view_item',
      ecommerce: {
        currency: 'MXN',
        value: 97,
        items: [{ item_id: 'tarjetas-afirmaciones', item_name: PRODUCT.content_name, price: 97, quantity: 1 }],
      },
    });

    // 2. UTM forwarding + InitiateCheckout on CTA click
    var currentParams = new URLSearchParams(window.location.search);
    var UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid'];

    // Persistir fbclid en cookie first-party para CAPI en /gracias
    var _fbclid = currentParams.get('fbclid');
    if (_fbclid) {
      var _cookieExp = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toUTCString();
      document.cookie = 'fbclid=' + encodeURIComponent(_fbclid) + '; path=/; expires=' + _cookieExp + '; SameSite=Lax';
      if (!document.cookie.includes('_fbc=')) {
        document.cookie = '_fbc=fb.1.' + Math.floor(Date.now() / 1000) + '.' + encodeURIComponent(_fbclid) + '; path=/; expires=' + _cookieExp + '; SameSite=Lax';
      }
    }

    document.querySelectorAll('a[href*="buy.stripe.com"]').forEach(function (btn) {
      try {
        var url = new URL(btn.href);
        UTM_KEYS.forEach(function (k) {
          var v = currentParams.get(k);
          if (v) url.searchParams.set(k, v);
        });
        btn.href = url.toString();
      } catch (_) {}

      btn.addEventListener('click', function () {
        if (window.fbq) {
          window.fbq('track', 'InitiateCheckout', {
            content_name: PRODUCT.content_name,
            content_ids: PRODUCT.content_ids,
            content_type: PRODUCT.content_type,
            value: PRODUCT.value,
            currency: PRODUCT.currency,
            num_items: 1,
          });
        }
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ ecommerce: null });
        window.dataLayer.push({
          event: 'begin_checkout',
          ecommerce: {
            currency: 'MXN',
            value: 97,
            items: [{ item_id: 'tarjetas-afirmaciones', item_name: PRODUCT.content_name, price: 97, quantity: 1 }],
          },
        });
      });
    });
  })();
  </script>
</BaseLayout>
