<script>
  // --- VSL Tracking Script ---
  let player;
  let trackedMilestones = new Set();
  
  function getCookie(name) {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop().split(';').shift();
    return null;
  }

  function reportMilestone(milestone) {
    if (trackedMilestones.has(milestone)) return;
    trackedMilestones.add(milestone);
    
    // Capture Meta Pixel Cookie _fbp
    const fbp = getCookie('_fbp') || '';
    
    fetch('https://api.einsteinkids.cynponceglz.com/webhooks/cyn/track-vsl', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ milestone, fbp }),
      keepalive: true
    }).catch(() => {});
  }

  // Load YouTube API
  const tag = document.createElement('script');
  tag.src = "https://www.youtube.com/iframe_api";
  const firstScriptTag = document.getElementsByTagName('script')[0];
  firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

  window.onYouTubeIframeAPIReady = function() {
    player = new YT.Player('vsl-video', {
      events: {
        'onStateChange': onPlayerStateChange
      }
    });
  };

  let checkInterval;
  function onPlayerStateChange(event) {
    if (event.data == YT.PlayerState.PLAYING) {
      checkInterval = setInterval(() => {
        if (!player || !player.getDuration) return;
        const duration = player.getDuration();
        const current = player.getCurrentTime();
        if (duration > 0) {
          const percent = (current / duration) * 100;
          if (percent >= 25 && !trackedMilestones.has(25)) reportMilestone(25);
          if (percent >= 50 && !trackedMilestones.has(50)) reportMilestone(50);
          if (percent >= 75 && !trackedMilestones.has(75)) reportMilestone(75);
          if (percent >= 90 && !trackedMilestones.has(90)) reportMilestone(90);
        }
      }, 2000);
    } else {
      clearInterval(checkInterval);
    }
  }
</script>
