---
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = {
  title: 'Einstein Kids | Entendiendo la biología de la conducta',
  description: 'Descubre qué puede haber detrás de la desregulación, los berrinches y el cansancio. Aprende a entender y apoyar a tu peque desde un enfoque biológico integral.',
};

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '';
const whatsappMessage = "Hola, vi el video de Einstein Kids y quiero más información";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<BaseLayout seo={seo}>
  <!-- HERO PRINCIPAL CON VSL -->
  <section class="relative min-h-screen flex flex-col items-center justify-center pt-8 pb-16 px-4 md:px-8 bg-[#FAFAF9] overflow-hidden border-b border-primary/10">
    <!-- Fondos Abstractos Calmados -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none -z-10">
      <div class="absolute top-[-15%] right-[-10%] w-[300px] h-[300px] md:w-[600px] md:h-[600px] bg-secondary/10 rounded-full blur-[80px] opacity-70"></div>
      <div class="absolute bottom-[-10%] left-[-10%] w-[300px] h-[300px] md:w-[500px] md:h-[500px] bg-primary/5 rounded-full blur-[80px] opacity-70"></div>
    </div>

    <!-- Contenido Hero -->
    <div class="max-w-4xl mx-auto w-full text-center space-y-6 md:space-y-8 animate-fade-in-up mt-8">
      <!-- Logo o Título Einstein Kids Visal -->
      <div class="mb-4">
        <h2 class="text-secondary font-bold tracking-widest uppercase text-sm md:text-base">Einstein Kids</h2>
      </div>

      <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold text-primary tracking-tight leading-[1.15]">
        Tu peque no es “difícil”. <br class="hidden md:block" />
        <span class="text-secondary relative inline-block mt-2">
          Tal vez su cuerpo te está pidiendo ayuda.
          <div class="absolute -bottom-1 left-0 w-full h-2 md:h-3 bg-secondary/20 rounded-full -z-10"></div>
        </span>
      </h1>

      <p class="text-base md:text-xl text-text-secondary leading-relaxed max-w-3xl mx-auto font-medium px-2">
        Descubre qué puede haber detrás de la desregulación, los berrinches, la saturación, el mal descanso y la irritabilidad infantil. Mira este video y aprende cómo entender mejor a tu peque desde el sistema nervioso, los perfiles sensoriales, la microbiota y la nutrición.
      </p>

      <!-- Video Embed -->
      <div class="w-full max-w-4xl mx-auto mt-8 md:mt-12">
        <div class="relative w-full overflow-hidden rounded-2xl shadow-2xl aspect-video border-[6px] border-white/50 backdrop-blur-sm bg-white/40">
          <iframe 
            class="absolute top-0 left-0 w-full h-full rounded-xl"
            src="https://www.youtube.com/embed/hwjIDP8vI4o?rel=0&modestbranding=1" 
            title="Video Einstein Kids" 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <!-- CTA Principal -->
      <div class="pt-8 flex flex-col items-center gap-3">
        <a 
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full md:w-auto inline-flex items-center justify-center gap-3 bg-[#25D366] text-white font-bold text-lg px-8 py-5 rounded-full hover:bg-[#20bd5a] transition-all transform hover:scale-105 shadow-xl shadow-green-500/20"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><path d="M17.498 14.382c-.301-.15-1.767-.867-2.04-.966-.274-.101-.473-.15-.673.15-.197.295-.771.964-.944 1.162-.175.195-.349.21-.646.075-.3-.15-1.263-.465-2.403-1.485-.888-.795-1.484-1.77-1.66-2.07-.174-.3-.019-.465.13-.615.136-.135.301-.345.451-.523.146-.181.194-.301.297-.496.1-.21.049-.375-.025-.524-.075-.15-.672-1.62-.922-2.206-.24-.584-.487-.51-.672-.51-.172-.015-.371-.015-.571-.015-.2 0-.523.074-.797.359-.273.3-1.045 1.02-1.045 2.475s1.07 2.865 1.219 3.075c.149.195 2.105 3.195 5.1 4.485.714.3 1.27.48 1.704.629.714.227 1.365.195 1.88.121.574-.09 1.767-.721 2.016-1.426.255-.705.255-1.305.18-1.425-.074-.135-.27-.21-.57-.345z"/><path d="M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.46 0 .104 5.334.104 11.897c0 2.09.546 4.133 1.583 5.938L0 24l6.338-1.655c1.761.965 3.766 1.476 5.811 1.476 6.586 0 11.942-5.334 11.942-11.897 0-3.18-.13-6.17-2.39-8.435L20.52 3.44zM12.045 21.84c-1.785 0-3.535-.479-5.068-1.385l-.36-.214-3.766.985.998-3.666-.235-.374a9.863 9.863 0 0 1-1.503-5.263C2.112 6.47 6.556 2.04 12.045 2.04c2.663 0 5.168 1.04 7.051 2.923 1.883 1.884 2.922 4.381 2.922 7.031 0 5.43-4.444 9.846-9.973 9.846z"/></svg>
          Quiero orientación por WhatsApp
        </a>
        <p class="text-sm md:text-base text-text-secondary mt-1 md:mt-2 text-center max-w-md">
          Te atenderemos directo por WhatsApp para orientarte según la etapa y necesidades de tu peque.
        </p>
      </div>
    </div>
  </section>

  <!-- BLOQUE: IDENTIFICACIÓN / DOLOR -->
  <section class="py-20 px-4 md:px-8 bg-white">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-primary mb-12">
        Tal vez esto te suena familiar...
      </h2>

      <div class="grid gap-4 md:gap-6">
        {[
          'Explota por cosas pequeñas',
          'Se distrae con todo',
          'Parece saturarse fácilmente',
          'Duerme mal o se despierta llorando',
          'Vive irritable o con baja tolerancia',
          'Tú haces lo mejor que puedes... y aun así sientes que algo no termina de encajar'
        ].map((item) => (
          <div class="flex items-start gap-4 p-5 md:p-6 bg-[#FAFAF9] rounded-2xl border border-secondary/10 hover:border-secondary/30 transition-colors">
            <div class="bg-secondary/10 p-2 rounded-full mt-0.5 text-secondary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <p class="text-lg text-text-primary font-medium leading-tight">{item}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 p-6 md:p-8 bg-primary text-white rounded-3xl text-center shadow-2xl relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-secondary/30 rounded-full blur-2xl transform translate-x-10 -translate-y-10"></div>
        <p class="text-xl md:text-2xl font-bold relative z-10 leading-snug">
          Esto no siempre es mala crianza. Muchas veces hay algo más profundo pasando en su cuerpo.
        </p>
      </div>
    </div>
  </section>

  <!-- BLOQUE: REENCUADRE -->
  <section class="py-24 px-4 md:px-8 bg-gradient-to-b from-[#FAFAF9] to-white relative">
    <div class="max-w-4xl mx-auto text-center space-y-8">
      <div class="inline-flex items-center justify-center p-4 bg-secondary/10 rounded-full mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" class="text-secondary" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-primary tracking-tight">
        La conducta también tiene <span class="text-secondary">biología</span>
      </h2>
      <p class="text-lg md:text-2xl text-text-primary/80 leading-relaxed font-medium max-w-3xl mx-auto">
        Muchos comportamientos infantiles no empiezan en la "mala actitud", sino en un sistema nervioso saturado, una desregulación sensorial, una microbiota alterada o una base biológica que necesita apoyo. Cuando el cuerpo está en alerta constante, al peque le cuesta enfocarse, dormir, tolerar y regularse.
      </p>
    </div>
  </section>

  <!-- BLOQUE: QUÉ VAS A DESCUBRIR -->
  <section class="py-20 px-4 md:px-8 bg-primary">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-white mb-16">
        En este video vas a descubrir:
      </h2>

      <div class="grid md:grid-cols-2 gap-x-12 gap-y-8">
        {[
          'Qué son los perfiles sensoriales y por qué todos los niños tienen uno',
          'Cómo detectar señales de posible desintegración sensorial',
          'Por qué un niño no puede vivir calmado si no conoce la calma',
          'Cómo el sistema nervioso, el intestino y la alimentación impactan la regulación',
          'Qué cambios sí puedes empezar a hacer en casa',
          'Cómo Einstein Kids puede apoyar nutrición, microbiota y bienestar general'
        ].map((item, i) => (
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-secondary/30 text-secondary font-bold text-sm border border-secondary/50 mt-1">
              {i + 1}
            </span>
            <p class="text-lg text-white/90 font-medium leading-snug transform hover:translate-x-2 transition-transform">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BLOQUE: REGALOS / BONUSES -->
  <section class="py-24 px-4 md:px-8 bg-white">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16 max-w-3xl mx-auto space-y-4">
        <span class="px-4 py-1.5 rounded-full bg-secondary/10 text-secondary font-semibold text-sm tracking-wide uppercase">Bonuses Exclusivos</span>
        <h2 class="text-3xl md:text-4xl font-bold text-primary">
          Además, al ver este contenido y escribirnos, podrás conocer estos regalos:
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Regalo 1 -->
        <div class="bg-[#FAFAF9] rounded-3xl p-8 md:p-10 border border-primary/5 hover:shadow-xl transition-shadow relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-32 h-32 bg-secondary/10 rounded-full blur-2xl transform translate-x-10 -translate-y-10 group-hover:scale-150 transition-transform duration-500"></div>
          <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm mb-6 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
          </div>
          <h3 class="text-2xl font-bold text-primary mb-4 relative z-10">Ebook de actividades por perfil sensorial</h3>
          <p class="text-text-secondary text-lg leading-relaxed relative z-10">Actividades fáciles y prácticas para aplicar en casa según el tipo de perfil sensorial de tu peque.</p>
        </div>

        <!-- Regalo 2 -->
        <div class="bg-[#FAFAF9] rounded-3xl p-8 md:p-10 border border-primary/5 hover:shadow-xl transition-shadow relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full blur-2xl transform translate-x-10 -translate-y-10 group-hover:scale-150 transition-transform duration-500"></div>
          <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm mb-6 text-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><path d="M12 8v8"/><path d="M8 12h8"/></svg>
          </div>
          <h3 class="text-2xl font-bold text-primary mb-4 relative z-10">Tarjetas de afirmaciones positivas</h3>
          <p class="text-text-secondary text-lg leading-relaxed relative z-10">Para conectar a tus peques con la calma todos los días y fortalecer su seguridad interior desde pequeños.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOQUE: TESTIMONIOS REALES -->
  <section class="py-20 px-4 md:px-8 bg-[#f5f7f6]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-primary tracking-tight mb-4 text-center">
          Lo que otras mamás ya están viviendo
        </h2>
        <p class="text-lg text-text-secondary">
          Testimonios reales compartidos por familias de la comunidad Einstein Kids.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {[
          { link: 'https://www.instagram.com/reel/DOFXHKmDUt9/', name: 'Familia 1' },
          { link: 'https://www.instagram.com/reel/DNOGuNURDuq/', name: 'Familia 2' },
          { link: 'https://www.instagram.com/reel/DLQCgYWx_EP/', name: 'Familia 3' }
        ].map((testimonial) => (
          <div class="bg-white rounded-3xl p-6 shadow-lg shadow-black/5 flex flex-col items-center text-center hover:-translate-y-2 transition-transform duration-300">
            <div class="w-16 h-16 bg-gradient-to-tr from-pink-500 via-red-500 to-yellow-500 rounded-full flex items-center justify-center text-white mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </div>
            <p class="text-text-primary font-semibold mb-8">Nuestra comunidad sigue creciendo. Descubre la historia de esta {testimonial.name.toLowerCase()} en nuestro Instagram oficial.</p>
            <a 
              href={testimonial.link}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-auto px-6 py-3 w-full rounded-2xl bg-primary/5 text-primary font-semibold hover:bg-primary/10 transition-colors flex items-center justify-center gap-2"
            >
              Ver testimonio
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BLOQUE: CTA FUERTE WHATSAPP -->
  <section class="py-24 px-4 md:px-8 bg-primary relative overflow-hidden">
    <div class="absolute inset-0 w-full h-full pointer-events-none">
      <div class="absolute top-[-50%] right-[-10%] w-[600px] h-[600px] bg-secondary/20 rounded-full blur-[100px]"></div>
    </div>

    <div class="max-w-3xl mx-auto text-center space-y-8 relative z-10">
      <h2 class="text-3xl md:text-5xl font-bold text-white tracking-tight">Da el siguiente paso</h2>
      
      <p class="textxl md:text-2xl text-white/90 font-light leading-relaxed">
        Si este video resonó contigo y quieres orientación para entender mejor qué puede estar pasando con tu peque, escríbenos por WhatsApp. Te ayudaremos a identificar por dónde empezar.
      </p>

      <div class="pt-8">
        <a 
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-3 bg-[#25D366] text-white font-bold text-xl px-10 py-6 rounded-full hover:bg-[#20bd5a] transition-all transform hover:scale-105 shadow-2xl"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.498 14.382c-.301-.15-1.767-.867-2.04-.966-.274-.101-.473-.15-.673.15-.197.295-.771.964-.944 1.162-.175.195-.349.21-.646.075-.3-.15-1.263-.465-2.403-1.485-.888-.795-1.484-1.77-1.66-2.07-.174-.3-.019-.465.13-.615.136-.135.301-.345.451-.523.146-.181.194-.301.297-.496.1-.21.049-.375-.025-.524-.075-.15-.672-1.62-.922-2.206-.24-.584-.487-.51-.672-.51-.172-.015-.371-.015-.571-.015-.2 0-.523.074-.797.359-.273.3-1.045 1.02-1.045 2.475s1.07 2.865 1.219 3.075c.149.195 2.105 3.195 5.1 4.485.714.3 1.27.48 1.704.629.714.227 1.365.195 1.88.121.574-.09 1.767-.721 2.016-1.426.255-.705.255-1.305.18-1.425-.074-.135-.27-.21-.57-.345z"/><path d="M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.46 0 .104 5.334.104 11.897c0 2.09.546 4.133 1.583 5.938L0 24l6.338-1.655c1.761.965 3.766 1.476 5.811 1.476 6.586 0 11.942-5.334 11.942-11.897 0-3.18-.13-6.17-2.39-8.435L20.52 3.44zM12.045 21.84c-1.785 0-3.535-.479-5.068-1.385l-.36-.214-3.766.985.998-3.666-.235-.374a9.863 9.863 0 0 1-1.503-5.263C2.112 6.47 6.556 2.04 12.045 2.04c2.663 0 5.168 1.04 7.051 2.923 1.883 1.884 2.922 4.381 2.922 7.031 0 5.43-4.444 9.846-9.973 9.846z"/></svg>
          Hablar por WhatsApp ahora
        </a>
      </div>
    </div>
  </section>

  <!-- BLOQUE: FAQ -->
  <section class="py-24 px-4 md:px-8 bg-white">
    <div class="max-w-3xl mx-auto space-y-12">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-primary">Preguntas Frecuentes</h2>

      <div class="space-y-6">
        {[
          { q: '¿Este video sustituye una consulta médica?', a: 'No. Es contenido educativo e informativo para mamás y papás.' },
          { q: '¿Necesito llenar un formulario?', a: 'No. Puedes ver el video y escribirnos directo por WhatsApp.' },
          { q: '¿Einstein Kids sustituye terapias o tratamientos?', a: 'No. Es apoyo nutricional dentro de un enfoque integral.' },
          { q: '¿Cómo sé por dónde empezar?', a: 'Escríbenos por WhatsApp y te orientamos según lo que hoy vive tu peque.' }
        ].map((faq) => (
          <div class="bg-[#FAFAF9] p-6 rounded-2xl border border-primary/5">
            <h3 class="text-xl font-bold text-primary mb-3 flex items-center gap-3">
              <span class="text-secondary opacity-70">?</span>
              {faq.q}
            </h3>
            <p class="text-text-secondary text-lg leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sticky Mobile Button -->
  <a 
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="md:hidden fixed bottom-6 right-6 z-50 bg-[#25D366] text-white p-4 rounded-full shadow-2xl hover:scale-105 transition-transform animate-fade-in-up"
    aria-label="Hablar por WhatsApp"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.498 14.382c-.301-.15-1.767-.867-2.04-.966-.274-.101-.473-.15-.673.15-.197.295-.771.964-.944 1.162-.175.195-.349.21-.646.075-.3-.15-1.263-.465-2.403-1.485-.888-.795-1.484-1.77-1.66-2.07-.174-.3-.019-.465.13-.615.136-.135.301-.345.451-.523.146-.181.194-.301.297-.496.1-.21.049-.375-.025-.524-.075-.15-.672-1.62-.922-2.206-.24-.584-.487-.51-.672-.51-.172-.015-.371-.015-.571-.015-.2 0-.523.074-.797.359-.273.3-1.045 1.02-1.045 2.475s1.07 2.865 1.219 3.075c.149.195 2.105 3.195 5.1 4.485.714.3 1.27.48 1.704.629.714.227 1.365.195 1.88.121.574-.09 1.767-.721 2.016-1.426.255-.705.255-1.305.18-1.425-.074-.135-.27-.21-.57-.345z"/><path d="M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.46 0 .104 5.334.104 11.897c0 2.09.546 4.133 1.583 5.938L0 24l6.338-1.655c1.761.965 3.766 1.476 5.811 1.476 6.586 0 11.942-5.334 11.942-11.897 0-3.18-.13-6.17-2.39-8.435L20.52 3.44zM12.045 21.84c-1.785 0-3.535-.479-5.068-1.385l-.36-.214-3.766.985.998-3.666-.235-.374a9.863 9.863 0 0 1-1.503-5.263C2.112 6.47 6.556 2.04 12.045 2.04c2.663 0 5.168 1.04 7.051 2.923 1.883 1.884 2.922 4.381 2.922 7.031 0 5.43-4.444 9.846-9.973 9.846z"/></svg>
  </a>

</BaseLayout>
