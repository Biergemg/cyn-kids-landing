---
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = {
  title: 'Cyn | Entendiendo la biología de la conducta',
  description: 'Descubre qué puede haber detrás de la desregulación, los berrinches y el cansancio. Aprende a entender y apoyar a tu peque desde un enfoque biológico integral.',
};

const whatsappUrl = "https://wa.me/528334875588?text=Hola,%20vi%20el%20video%20y%20quiero%20m%C3%A1s%20informaci%C3%B3n";
---

<BaseLayout seo={seo}>
