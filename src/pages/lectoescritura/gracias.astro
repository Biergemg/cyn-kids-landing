---
import BaseLayout from '../../layouts/BaseLayout.astro';

// UUID del directorio de descarga — no cambiar, no compartir públicamente
const DL = "/dl/475068dba4230539160d";

// Canva: reemplaza este link por el link de PLANTILLA (Share → Template link),
// NO uses el link de edición (/edit) ya que permite modificar el original.
const CANVA_TEMPLATE_URL = "REEMPLAZAR_CON_LINK_DE_PLANTILLA_CANVA";

const seo = {
  title: 'Descarga tu kit | Cyn',
  description: 'Tu compra fue exitosa. Descarga los materiales del Kit de Lectoescritura Temprana.',
  noindex: true,
};
---

<BaseLayout seo={seo}>

  <section class="min-h-screen flex flex-col items-center justify-center px-5 py-20 bg-[#FAFAF9]">
    <div class="w-full max-w-lg mx-auto">

      <!-- Confirmación -->
      <div class="text-center mb-14">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-secondary/10 mb-6">
          <svg class="w-7 h-7 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <h1 class="text-2xl md:text-3xl font-semibold text-primary mb-3">
          Tu kit está listo.
        </h1>
        <p class="text-base text-text-secondary leading-relaxed max-w-sm mx-auto">
          Compra confirmada. Descarga cada archivo directamente desde aquí. Los archivos son tuyos sin límite de tiempo.
        </p>
      </div>

      <!-- Descargas -->
      <div class="space-y-4 mb-12">

        <a
          href={`${DL}/activar-dos-hemisferios.pdf`}
          download="Activar-dos-hemisferios-Cyn.pdf"
          class="flex items-center gap-5 p-5 bg-white border border-[#E5E7EB] rounded-md hover:border-secondary/40 hover:bg-secondary/5 transition-colors duration-200 group"
        >
          <div class="flex-shrink-0 w-10 h-10 bg-primary/5 rounded flex items-center justify-center">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-primary">Activar dos hemisferios</p>
            <p class="text-xs text-text-secondary">Espirales y trazos de manos · 8 páginas · PDF</p>
          </div>
          <svg class="w-4 h-4 text-secondary group-hover:translate-y-0.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
        </a>

        <a
          href={`${DL}/ejercicios-rastreo-visual.pdf`}
          download="Ejercicios-rastreo-visual-Cyn.pdf"
          class="flex items-center gap-5 p-5 bg-white border border-[#E5E7EB] rounded-md hover:border-secondary/40 hover:bg-secondary/5 transition-colors duration-200 group"
        >
          <div class="flex-shrink-0 w-10 h-10 bg-primary/5 rounded flex items-center justify-center">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-primary">Ejercicios de rastreo visual</p>
            <p class="text-xs text-text-secondary">5 fichas de discriminación visual · PDF</p>
          </div>
          <svg class="w-4 h-4 text-secondary group-hover:translate-y-0.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
        </a>

        <a
          href={`${DL}/trazo-de-alfabeto.pdf`}
          download="Trazo-de-alfabeto-Cyn.pdf"
          class="flex items-center gap-5 p-5 bg-white border border-[#E5E7EB] rounded-md hover:border-secondary/40 hover:bg-secondary/5 transition-colors duration-200 group"
        >
          <div class="flex-shrink-0 w-10 h-10 bg-primary/5 rounded flex items-center justify-center">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-primary">Trazo de alfabeto A-Z</p>
            <p class="text-xs text-text-secondary">26 letras con orden de trazo · PDF</p>
          </div>
          <svg class="w-4 h-4 text-secondary group-hover:translate-y-0.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
        </a>

        <!-- Canva -->
        {CANVA_TEMPLATE_URL !== "REEMPLAZAR_CON_LINK_DE_PLANTILLA_CANVA" ? (
          <a
            href={CANVA_TEMPLATE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-5 p-5 bg-white border border-[#E5E7EB] rounded-md hover:border-secondary/40 hover:bg-secondary/5 transition-colors duration-200 group"
          >
            <div class="flex-shrink-0 w-10 h-10 bg-primary/5 rounded flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-primary">Plantilla editable en Canva</p>
              <p class="text-xs text-text-secondary">Abre directamente en Canva · Editable y reusable</p>
            </div>
            <svg class="w-4 h-4 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        ) : (
          <div class="flex items-center gap-5 p-5 bg-[#F9FAFB] border border-dashed border-[#E5E7EB] rounded-md opacity-60">
            <div class="flex-shrink-0 w-10 h-10 bg-primary/5 rounded flex items-center justify-center">
              <svg class="w-5 h-5 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </div>
            <div class="flex-1">
              <p class="text-sm font-semibold text-text-secondary">Plantilla Canva</p>
              <p class="text-xs text-text-secondary">Próximamente disponible</p>
            </div>
          </div>
        )}

      </div>

      <!-- Nota -->
      <div class="bg-secondary/8 border border-secondary/20 rounded-md p-5">
        <p class="text-sm text-primary/80 leading-relaxed">
          <strong class="font-semibold">Guarda esta página.</strong> Los archivos estarán disponibles desde este enlace sin límite de tiempo. Si tienes algún problema con la descarga, escribe a <a href="mailto:info@cynponceglz.com" class="text-secondary underline underline-offset-2">info@cynponceglz.com</a>.
        </p>
      </div>

    </div>
  </section>

</BaseLayout>
