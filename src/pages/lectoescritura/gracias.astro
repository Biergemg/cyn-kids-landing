---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import crypto from 'node:crypto';

// UUID del directorio de descarga. No cambiar ni compartir públicamente.
const DL = "/dl/475068dba4230539160d";

// Canva: link de plantilla, no link de edición.
const CANVA_TEMPLATE_URL = "https://canva.link/1po9unthgj2y8mh";

// ── Facebook Conversions API (server-side Purchase) ─────────────────────────
const FB_PIXEL_ID = import.meta.env.FB_PIXEL_ID ?? '1024976901790952';
const FB_TOKEN    = import.meta.env.FB_ACCESS_TOKEN;

// event_id usado para deduplicación con el pixel de browser
const eventId = crypto.randomUUID();

if (FB_TOKEN) {
  const fbc = Astro.cookies.get('_fbc')?.value ?? undefined;
  const fbp = Astro.cookies.get('_fbp')?.value ?? undefined;
  let clientIp: string | undefined;
  try { clientIp = Astro.clientAddress; } catch (_) {}

  const payload = {
    data: [{
      event_name: 'Purchase',
      event_time: Math.floor(Date.now() / 1000),
      event_id: eventId,
      event_source_url: Astro.url.href,
      action_source: 'website',
      user_data: {
        ...(fbc ? { fbc } : {}),
        ...(fbp ? { fbp } : {}),
        ...(clientIp ? { client_ip_address: clientIp } : {}),
        client_user_agent: Astro.request.headers.get('user-agent') ?? '',
      },
      custom_data: {
        value: 197,
        currency: 'MXN',
        content_name: 'Kit de Inicio a la Lectoescritura',
        content_ids: ['kit-lectoescritura'],
        content_type: 'product',
        num_items: 1,
      },
    }],
  };

  try {
    const res = await fetch(
      `https://graph.facebook.com/v19.0/${FB_PIXEL_ID}/events?access_token=${FB_TOKEN}`,
      { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) }
    );
    if (!res.ok) console.error('[CAPI] error:', await res.text());
  } catch (err) {
    console.error('[CAPI] fetch failed:', err);
  }
}
// ───────────────────────────────────────────────────────────────────────────

const seo = {
  title: 'Descarga tu Kit de Lectoescritura | Cyn',
  description: 'Tu compra fue exitosa. Descarga los materiales del Kit de Inicio a la Lectoescritura.',
  noindex: true,
};

const downloads = [
  {
    title: 'Activar dos hemisferios',
    detail: 'Espirales y trazos de manos · 8 páginas · PDF',
    href: `${DL}/activar-dos-hemisferios.pdf`,
    filename: 'Activar-dos-hemisferios-Cyn.pdf',
  },
  {
    title: 'Ejercicios de rastreo visual',
    detail: '5 fichas de discriminación visual · PDF',
    href: `${DL}/ejercicios-rastreo-visual.pdf`,
    filename: 'Ejercicios-rastreo-visual-Cyn.pdf',
  },
  {
    title: 'Trazo de alfabeto A-Z',
    detail: '26 letras con orden de trazo · PDF',
    href: `${DL}/trazo-de-alfabeto.pdf`,
    filename: 'Trazo-de-alfabeto-Cyn.pdf',
  },
  {
    title: 'Guía Kit Lecto-Escritura',
    detail: 'Guía de uso e instrucciones · 14 páginas · PDF',
    href: `${DL}/guia-kit-lectoescritura.pdf`,
    filename: 'Guia-Kit-Lectoescritura-Cyn.pdf',
  },
];
---

<BaseLayout seo={seo}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet">
    <style>
      .lecto-thanks { font-family: 'Manrope', system-ui, sans-serif; background: #fff8ee; color: #392a24; }
      .display { font-family: 'Libre Baskerville', Georgia, serif; }
      .soft-shadow { box-shadow: 0 26px 70px rgba(87, 55, 41, 0.14); }
    </style>
  </Fragment>

  <main class="lecto-thanks min-h-screen px-5 py-12 md:py-20">
    <section class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <aside class="lg:sticky lg:top-8">
        <div class="rounded-[2rem] border border-[#ead9ca] bg-[#fffdf8] p-6 soft-shadow">
          <div class="mb-7 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#d87982]/16 text-[#bf5d69]">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-[#bf5d69]">Compra confirmada</p>
          <h1 class="display mt-4 text-3xl leading-tight tracking-[-0.03em] text-[#35261f] md:text-4xl">
            Tu kit está listo para descargar.
          </h1>
          <p class="mt-5 text-base leading-7 text-[#79665b]">
            Guarda esta página. Tus archivos estarán disponibles desde este enlace sin límite de tiempo.
          </p>
          <img
            src="/images/lectoescritura-mockup.png"
            alt="Mockup del Kit de Inicio a la Lectoescritura"
            class="mt-8 rounded-[1.4rem] border border-[#ead9ca]"
            loading="eager"
            decoding="async"
          />
        </div>
      </aside>

      <div>
        <div class="mb-6 rounded-[1.5rem] border border-[#ead9ca] bg-[#fffdf8] p-5">
          <p class="text-sm font-bold text-[#35261f]">Descarga los 5 materiales del kit</p>
          <p class="mt-1 text-sm leading-6 text-[#79665b]">Te recomendamos descargar primero la guía para saber cómo usar la secuencia.</p>
        </div>

        <div class="space-y-4">
          {downloads.map((file) => (
            <a
              href={file.href}
              download={file.filename}
              class="group flex items-center gap-5 rounded-[1.3rem] border border-[#ead9ca] bg-[#fffdf8] p-5 transition duration-200 hover:-translate-y-0.5 hover:border-[#d87982]/55 hover:bg-[#fff3f1] hover:shadow-xl hover:shadow-[#bf5d69]/10"
            >
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#d87982]/14 text-[#bf5d69]">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-extrabold text-[#35261f]">{file.title}</p>
                <p class="mt-1 text-xs leading-5 text-[#79665b]">{file.detail}</p>
              </div>
              <svg class="h-5 w-5 shrink-0 text-[#bf5d69] transition group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
            </a>
          ))}

          <a
            href={CANVA_TEMPLATE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-5 rounded-[1.3rem] border border-[#ead9ca] bg-[#fffdf8] p-5 transition duration-200 hover:-translate-y-0.5 hover:border-[#d87982]/55 hover:bg-[#fff3f1] hover:shadow-xl hover:shadow-[#bf5d69]/10"
          >
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#d87982]/14 text-[#bf5d69]">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-extrabold text-[#35261f]">Plantilla editable en Canva</p>
              <p class="mt-1 text-xs leading-5 text-[#79665b]">Abre directamente en Canva · Editable y reusable</p>
            </div>
            <svg class="h-5 w-5 shrink-0 text-[#bf5d69]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>

        <div class="mt-8 rounded-[1.3rem] border border-[#d87982]/25 bg-[#fff3f1] p-5">
          <p class="text-sm leading-7 text-[#5f4c42]">
            <strong class="font-extrabold text-[#35261f]">Si tienes algún problema con la descarga,</strong> escribe a <a href="mailto:info@cynponceglz.com" class="font-bold text-[#bf5d69] underline underline-offset-4">info@cynponceglz.com</a>.
          </p>
        </div>
      </div>
    </section>
  </main>

  <!-- ══════════════════════════════════════════════
       TRACKING — Facebook Pixel Purchase + GTM
       event_id sincronizado con CAPI server-side
  ══════════════════════════════════════════════ -->
  <script is:inline define:vars={{ eventId }}>
  (function () {
    // Browser-side Purchase — event_id deduplicates with CAPI server event
    if (window.fbq) {
      window.fbq('track', 'Purchase', {
        value: 197,
        currency: 'MXN',
        content_name: 'Kit de Inicio a la Lectoescritura',
        content_ids: ['kit-lectoescritura'],
        content_type: 'product',
        num_items: 1,
      }, { eventID: eventId });
    }

    // GTM / GA4 purchase
    var sessionId = new URLSearchParams(window.location.search).get('session_id') ?? '';
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ ecommerce: null });
    window.dataLayer.push({
      event: 'purchase',
      ecommerce: {
        transaction_id: sessionId,
        value: 197,
        currency: 'MXN',
        items: [{ item_id: 'kit-lectoescritura', item_name: 'Kit de Inicio a la Lectoescritura', price: 197, quantity: 1 }],
      },
    });
  })();
  </script>
</BaseLayout>
