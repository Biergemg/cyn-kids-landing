---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';

const STRIPE_LINK = "https://buy.stripe.com/28E9ATft02HW9HPbb92wU02";

const seo = {
  title: 'Kit de Inicio a la Lectoescritura | Cyn',
  description: 'Kit imprimible y descargable para preparar a niños de 3 a 6 años para leer y escribir con actividades de coordinación, rastreo visual, trazo y guía de uso.',
  image: '/images/lectoescritura-mockup.png',
  noindex: false,
};

const kitItems = [
  {
    name: 'Activar dos hemisferios',
    detail: '8 páginas imprimibles',
    text: 'Trazos en espiral y contornos de manos para preparar coordinación bilateral antes de exigir escritura.',
  },
  {
    name: 'Ejercicios de rastreo visual',
    detail: '5 fichas temáticas',
    text: 'Actividades de observación, discriminación y búsqueda visual para entrenar atención y escaneo izquierda a derecha.',
  },
  {
    name: 'Trazo de alfabeto A-Z',
    detail: '26 páginas',
    text: 'Letras mayúsculas y minúsculas con orden de trazo, líneas guía y espacio de práctica clara.',
  },
  {
    name: 'Guía Kit Lecto-Escritura',
    detail: '14 páginas de acompañamiento',
    text: 'Instrucciones para usar el kit con intención, orden y constancia sin convertirlo en presión diaria.',
  },
  {
    name: 'Plantilla editable en Canva',
    detail: 'Editable y reusable',
    text: 'Material adaptable para personalizar actividades, imprimir de nuevo y usarlo más de una vez.',
  },
];

const benefits = [
  'Tienes una secuencia clara, no actividades sueltas sin dirección.',
  'Puedes imprimirlo y usarlo en casa, salón o terapia de apoyo.',
  'Empieza por cuerpo, ojos y control motor antes de llegar a letras.',
  'Evita saturar al niño con planas interminables que no construyen base.',
];

const fit = [
  'Tu hijo tiene entre 3 y 6 años y quieres preparar sus bases de lectoescritura.',
  'Buscas material bonito, descargable y fácil de aplicar sin improvisar.',
  'Eres mamá, terapeuta o maestra y quieres actividades con lógica neuromotora.',
  'Quieres acompañar el proceso sin presión, con pasos cortos y repetibles.',
];

const notFit = [
  'Buscas una solución mágica o resultados en un solo día.',
  'Quieres reemplazar evaluación, terapia o acompañamiento profesional.',
  'Necesitas un programa clínico personalizado para un diagnóstico específico.',
];
---

<BaseLayout seo={seo}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet">
    <style>
      :root {
        --cream: #fff8ee;
        --cream-2: #f7eadb;
        --paper: #fffdf8;
        --ink: #392a24;
        --muted: #79665b;
        --rose: #d87982;
        --rose-deep: #bf5d69;
        --peach: #f0c7a3;
        --line: #ead9ca;
        --leaf: #6f7d55;
      }
      .lecto-page { font-family: 'Manrope', system-ui, sans-serif; background: var(--cream); color: var(--ink); }
      .display { font-family: 'Libre Baskerville', Georgia, serif; }
      .soft-shadow { box-shadow: 0 30px 80px rgba(87, 55, 41, 0.16); }
      .premium-ring { box-shadow: inset 0 0 0 1px rgba(191, 93, 105, 0.18), 0 20px 50px rgba(191, 93, 105, 0.12); }
    </style>
  </Fragment>

  <main class="lecto-page overflow-hidden">
    <!-- Hero -->
    <section class="relative px-5 pt-10 pb-20 md:pt-16 md:pb-28">
      <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div class="absolute -top-28 -right-20 h-80 w-80 rounded-full bg-[#f3c7c7]/50 blur-3xl"></div>
        <div class="absolute top-72 -left-28 h-96 w-96 rounded-full bg-[#f0c7a3]/45 blur-3xl"></div>
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#d87982]/30 to-transparent"></div>
      </div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-8 lg:gap-12 lg:grid-cols-[0.92fr_1.08fr]">
        <div class="order-2 lg:order-1">
          <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-[#eac8c7] bg-[#fffdf8]/80 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-[#bf5d69]">
            <span class="h-2 w-2 rounded-full bg-[#d87982]"></span>
            Descargable e imprimible
          </div>

          <h1 class="display max-w-3xl text-[2.55rem] leading-[1.08] tracking-[-0.04em] text-[#35261f] md:text-[4.35rem] lg:text-[4.8rem]">
            Kit de Inicio a la <span class="text-[#c96572]">Lectoescritura</span>
          </h1>

          <p class="mt-7 max-w-xl text-lg leading-8 text-[#6f5b50] md:text-xl">
            Actividades listas para imprimir que preparan cuerpo, ojos y mano antes de pedirle a tu peque que escriba letras completas.
          </p>

          <div class="mt-9 rounded-[1.6rem] border border-[#ead9ca] bg-[#fffdf8]/82 p-5 premium-ring backdrop-blur sm:max-w-xl">
            <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="text-sm font-bold uppercase tracking-[0.16em] text-[#bf5d69]">Pago único</p>
                <p class="mt-1 text-4xl font-extrabold tracking-[-0.04em] text-[#35261f]">$197 <span class="text-base font-semibold text-[#79665b]">MXN</span></p>
              </div>
              <a
                href={STRIPE_LINK}
                class="inline-flex items-center justify-center rounded-full bg-[#bf5d69] px-7 py-4 text-base font-extrabold text-[#fffdf8] transition duration-200 hover:-translate-y-0.5 hover:bg-[#a94c59] focus:outline-none focus:ring-4 focus:ring-[#d87982]/30"
              >
                Obtener el kit completo
              </a>
            </div>
            <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-[#79665b]">
              <span>5 materiales incluidos</span>
              <span>Descarga inmediata</span>
              <span>Pago seguro con Stripe</span>
            </div>
          </div>
        </div>

        <div class="order-1 lg:order-2">
          <div class="relative mx-auto max-w-[610px]">
            <div class="absolute -inset-4 rotate-2 rounded-[2rem] bg-[#d87982]/18 blur-2xl"></div>
            <img
              src="/images/lectoescritura-mockup.png"
              alt="Mockup del Kit de Inicio a la Lectoescritura con hojas imprimibles, guía y actividades visuales"
              class="relative w-full rounded-[1.8rem] border border-[#fffdf8] bg-[#fffdf8] object-cover soft-shadow"
              width="1086"
              height="1448"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Pain -->
    <section class="bg-[#fffdf8] px-5 py-20 md:py-28">
      <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-[0.9fr_1.1fr] md:items-start">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-[#bf5d69]">El problema real</p>
          <h2 class="display mt-4 text-3xl leading-tight tracking-[-0.03em] text-[#35261f] md:text-5xl">
            No siempre faltan ganas. Muchas veces falta base.
          </h2>
        </div>
        <div class="space-y-6 text-lg leading-8 text-[#6f5b50]">
          <p>
            Cuando un niño batalla con el trazo, la respuesta común es darle más letras, más planas y más repetición. Pero escribir no empieza en la letra.
          </p>
          <p>
            Antes del lápiz hay coordinación bilateral, rastreo visual, control ojo mano y tolerancia para sostener la actividad. Si esa base no está lista, repetir más no necesariamente ayuda.
          </p>
          <p class="rounded-[1.4rem] bg-[#fff3f1] p-5 font-bold text-[#9f4d56]">
            Este kit empieza antes de la letra, justo donde el proceso necesita construirse.
          </p>
        </div>
      </div>
    </section>

    <!-- Includes -->
    <section class="px-5 py-20 md:py-28">
      <div class="mx-auto max-w-6xl">
        <div class="mb-14 max-w-2xl">
          <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-[#bf5d69]">Qué incluye</p>
          <h2 class="display mt-4 text-3xl leading-tight tracking-[-0.03em] text-[#35261f] md:text-5xl">
            Cinco materiales para practicar con intención.
          </h2>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
          {kitItems.map((item, index) => (
            <article class={`group rounded-[1.6rem] border border-[#ead9ca] bg-[#fffdf8] p-5 transition duration-200 hover:-translate-y-1 hover:border-[#d87982]/45 hover:shadow-xl hover:shadow-[#bf5d69]/10 lg:min-h-[280px]${index === kitItems.length - 1 ? ' sm:col-span-2 lg:col-span-1' : ''}`}>
              <div class="mb-8 flex items-center justify-between">
                <span class="display text-4xl font-bold text-[#e4b0b5]">{String(index + 1).padStart(2, '0')}</span>
                <span class="h-3 w-3 rounded-full bg-[#d87982]/55 transition group-hover:bg-[#bf5d69]"></span>
              </div>
              <h3 class="text-lg font-extrabold leading-tight text-[#35261f]">{item.name}</h3>
              <p class="mt-2 text-xs font-extrabold uppercase tracking-[0.13em] text-[#bf5d69]">{item.detail}</p>
              <p class="mt-5 text-sm leading-6 text-[#79665b]">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Mechanism -->
    <section class="bg-[#35261f] px-5 py-20 text-[#fff8ee] md:py-28">
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1fr_0.9fr] lg:items-center">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-[#f0b3b8]">La diferencia</p>
          <h2 class="display mt-4 text-3xl leading-tight tracking-[-0.03em] md:text-5xl">
            Una secuencia bonita, sí. Pero sobre todo, una secuencia con lógica.
          </h2>
        </div>
        <div class="grid gap-4">
          {[
            ['1', 'Coordinar', 'Los dos lados del cuerpo trabajan juntos para preparar estabilidad y dirección.'],
            ['2', 'Rastrear', 'Los ojos practican buscar, seguir y discriminar información visual.'],
            ['3', 'Trazar', 'La mano llega a la letra con una ruta más clara y menos frustración.'],
          ].map(([num, title, text]) => (
            <div class="flex gap-5 rounded-[1.4rem] border border-[#fff8ee]/12 bg-[#fff8ee]/6 p-5">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#d87982] text-sm font-extrabold text-[#35261f]">{num}</div>
              <div>
                <h3 class="font-extrabold text-[#fffdf8]">{title}</h3>
                <p class="mt-1 text-sm leading-6 text-[#ead9ca]">{text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Value -->
    <section class="bg-[#fffdf8] px-5 py-20 md:py-28">
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
        <div class="relative mx-auto max-w-md lg:max-w-none lg:mx-0">
          <img
            src="/images/lectoescritura-mockup.png"
            alt="Vista del producto descargable Kit de Inicio a la Lectoescritura"
            class="w-full rounded-[1.6rem] border border-[#ead9ca] soft-shadow"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-[#bf5d69]">Por qué convierte en práctica</p>
          <h2 class="display mt-4 text-3xl leading-tight tracking-[-0.03em] text-[#35261f] md:text-5xl">
            Menos improvisación. Más claridad para acompañar.
          </h2>
          <div class="mt-9 grid gap-4 sm:grid-cols-2">
            {benefits.map((benefit) => (
              <div class="rounded-[1.3rem] border border-[#ead9ca] bg-[#fff8ee] p-5">
                <svg class="mb-4 h-5 w-5 text-[#bf5d69]" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M4 10.5l3.4 3.4L16 5.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <p class="text-sm font-semibold leading-6 text-[#5f4c42]">{benefit}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Fit -->
    <section class="px-5 py-20 md:py-28">
      <div class="mx-auto max-w-6xl">
        <h2 class="display max-w-2xl text-3xl leading-tight tracking-[-0.03em] text-[#35261f] md:text-5xl">
          Para quién tiene sentido este kit
        </h2>
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          <div class="rounded-[1.6rem] border border-[#ead9ca] bg-[#fffdf8] p-6 md:p-8">
            <p class="mb-7 text-xs font-extrabold uppercase tracking-[0.18em] text-[#bf5d69]">Sí es para ti si</p>
            <ul class="space-y-5">
              {fit.map((item) => (
                <li class="flex gap-3 text-sm font-semibold leading-6 text-[#5f4c42]">
                  <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-[#d87982]"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="rounded-[1.6rem] border border-[#ead9ca] bg-[#f7eadb]/55 p-6 md:p-8">
            <p class="mb-7 text-xs font-extrabold uppercase tracking-[0.18em] text-[#79665b]">No es para ti si</p>
            <ul class="space-y-5">
              {notFit.map((item) => (
                <li class="flex gap-3 text-sm font-semibold leading-6 text-[#79665b]">
                  <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full border border-[#79665b]/45"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="relative px-5 pb-28 pt-12 md:pb-32">
      <div class="mx-auto max-w-4xl rounded-[2rem] bg-[#35261f] p-7 text-center text-[#fff8ee] soft-shadow md:p-12">
        <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-[#f0b3b8]">Descarga inmediata</p>
        <h2 class="display mx-auto mt-4 max-w-2xl text-3xl leading-tight tracking-[-0.03em] md:text-5xl">
          Empieza hoy con un kit que se ve bonito y se usa con propósito.
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-7 text-[#ead9ca]">
          Recibe los 5 materiales digitales, imprímelos cuando quieras y acompaña los primeros pasos hacia la lectoescritura sin improvisar.
        </p>

        <div class="mx-auto mt-9 max-w-md rounded-[1.4rem] border border-[#fff8ee]/12 bg-[#fff8ee]/7 p-5">
          <p class="text-5xl font-extrabold tracking-[-0.05em]">$197 <span class="text-lg font-semibold text-[#ead9ca]">MXN</span></p>
          <p class="mt-2 text-sm font-semibold text-[#ead9ca]">Pago único · Acceso permanente · Pago seguro</p>
          <a
            href={STRIPE_LINK}
            class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-[#d87982] px-7 py-4 text-base font-extrabold text-[#35261f] transition duration-200 hover:-translate-y-0.5 hover:bg-[#f0b3b8] focus:outline-none focus:ring-4 focus:ring-[#d87982]/30"
          >
            Obtener el kit completo
          </a>
        </div>

        <p class="mx-auto mt-6 max-w-xl text-xs leading-5 text-[#cdbbac]">
          Material educativo descargable. No reemplaza evaluación, terapia ni acompañamiento profesional cuando sea necesario.
        </p>
      </div>
    </section>

    <!-- Mobile sticky CTA -->
    <div class="fixed bottom-0 left-0 right-0 z-50 border-t border-[#ead9ca] bg-[#fffdf8]/95 px-4 py-3 backdrop-blur md:hidden">
      <a
        href={STRIPE_LINK}
        class="block rounded-full bg-[#bf5d69] px-6 py-3 text-center text-sm font-extrabold text-[#fffdf8] transition-colors duration-200 hover:bg-[#a94c59]"
      >
        Obtener el kit completo · $197 MXN
      </a>
    </div>
  </main>
</BaseLayout>
